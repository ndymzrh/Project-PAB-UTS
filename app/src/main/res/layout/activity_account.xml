<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bk_bg_screen"
    android:clipChildren="false"
    android:orientation="vertical"
    tools:context=".AccountActivity">

    <include layout="@layout/include_top_bar" />

    <!-- height 0dp + weight 1 = ScrollView mengambil semua sisa tinggi layar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:paddingBottom="32dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ KARTU PROFIL ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/bk_stroke_soft"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Baris atas: avatar | nama+kontak | tombol edit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Avatar inisial + badge verified di pojok kanan bawah -->
                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <TextView
                                android:id="@+id/tvAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_avatar"
                                android:gravity="center"
                                android:text="BS"
                                android:textColor="@android:color/white"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="bottom|end"
                                android:background="@drawable/bg_badge_white"
                                android:importantForAccessibility="no"
                                android:padding="2dp"
                                android:src="@drawable/ic_verified"
                                app:tint="@color/bk_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nama Pengguna"
                                android:textColor="@color/bk_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!-- Chip "Member Loyal" : ikon bintang dipasang lewat drawableStart -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_status_chip"
                                android:drawablePadding="4dp"
                                android:drawableStart="@drawable/ic_star"
                                android:drawableTint="@color/bk_accent"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:text="@string/member_loyal"
                                android:textColor="@color/bk_accent"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="-"
                                android:textColor="@color/bk_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textColor="@color/bk_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Tombol edit (lingkaran) -->
                        <FrameLayout
                            android:id="@+id/btnEditProfile"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/edit_profil"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/bk_primary" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Baris statistik: 3 kotak sama lebar (weight 1 semua) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Mobil -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat_box"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/tvStatCars"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/bk_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4dp"
                                android:drawableStart="@drawable/ic_car"
                                android:drawableTint="@color/bk_text_secondary"
                                android:gravity="center_vertical"
                                android:text="@string/stat_mobil"
                                android:textColor="@color/bk_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Servis aktif -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat_box"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/tvStatActive"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/bk_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4dp"
                                android:drawableStart="@drawable/ic_build"
                                android:drawableTint="@color/bk_text_secondary"
                                android:gravity="center_vertical"
                                android:text="@string/stat_servis_aktif"
                                android:textColor="@color/bk_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Poin -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat_box"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/tvStatPoints"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/bk_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4dp"
                                android:drawableStart="@drawable/ic_star"
                                android:drawableTint="@color/bk_text_secondary"
                                android:gravity="center_vertical"
                                android:text="@string/stat_poin"
                                android:textColor="@color/bk_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ SERVIS SEDANG BERJALAN (disembunyikan jika tidak ada) ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/bk_stroke_soft"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_square">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_build"
                            app:tint="@color/bk_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/servis_berjalan"
                            android:textColor="@color/bk_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActiveServiceDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="-"
                            android:textColor="@color/bk_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrackService"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="@string/pantau"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:backgroundTint="@color/bk_accent"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ HEADER KENDARAAN TERDAFTAR ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_car"
                    app:tint="@color/bk_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/kendaraan_terdaftar"
                    android:textColor="@color/bk_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddCar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/ic_add_circle"
                    android:drawableTint="@color/bk_accent"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:padding="4dp"
                    android:text="@string/tambah_mobil"
                    android:textColor="@color/bk_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ============ KARTU KENDARAAN ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/bk_stroke_soft"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Tampil jika belum ada mobil -->
                    <TextView
                        android:id="@+id/tvNoVehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="28dp"
                        android:text="@string/acc_belum_ada_mobil"
                        android:textColor="@color/bk_text_secondary"
                        android:textSize="13sp" />

                    <!-- Tampil jika ada mobil -->
                    <LinearLayout
                        android:id="@+id/layoutVehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <!-- Foto (placeholder) + nama + plat -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:background="@drawable/bg_vehicle_photo">

                                <ImageView
                                    android:id="@+id/ivVehicle"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_car"
                                    app:tint="@color/bk_primary" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvVehicleName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:textColor="@color/bk_text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/chipPrimary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/bg_status_chip"
                                    android:paddingStart="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="3dp"
                                    android:text="@string/mobil_utama"
                                    android:textColor="@color/bk_accent"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvPlate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/bg_plate_account"
                                    android:fontFamily="monospace"
                                    android:paddingStart="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="3dp"
                                    android:text="-"
                                    android:textColor="@color/bk_text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Odometer + servis berikutnya -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_box"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawablePadding="6dp"
                                    android:drawableStart="@drawable/ic_speed"
                                    android:drawableTint="@color/bk_text_secondary"
                                    android:gravity="center_vertical"
                                    android:text="@string/acc_odometer_saat_ini"
                                    android:textColor="@color/bk_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvOdometer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="-"
                                    android:textColor="@color/bk_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stat_box"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawablePadding="6dp"
                                    android:drawableStart="@drawable/ic_calendar"
                                    android:drawableTint="@color/bk_text_secondary"
                                    android:gravity="center_vertical"
                                    android:text="@string/servis_berikutnya_label"
                                    android:textColor="@color/bk_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvNextService"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="-"
                                    android:textColor="@color/bk_accent"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Tombol aksi -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnManageCar"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/kelola_mobil"
                                android:textAllCaps="false"
                                android:textColor="@color/bk_primary"
                                android:textSize="13sp"
                                app:backgroundTint="@color/bk_icon_circle_bg"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_tune"
                                app:iconGravity="textStart"
                                app:iconSize="18dp"
                                app:iconTint="@color/bk_primary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBookService"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/booking_servis"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="13sp"
                                app:backgroundTint="@color/bk_accent"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_calendar"
                                app:iconGravity="textStart"
                                app:iconSize="18dp"
                                app:iconTint="@android:color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ LAYANAN & AKUN ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.08"
                android:text="@string/section_layanan_akun"
                android:textColor="@color/bk_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/bk_stroke_soft"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- android:id pada <include> = nama binding di Kotlin: binding.menuHistory -->
                    <include
                        android:id="@+id/menuHistory"
                        layout="@layout/item_menu_row" />

                    <View style="@style/AccountDivider" />

                    <include
                        android:id="@+id/menuAddress"
                        layout="@layout/item_menu_row" />

                    <View style="@style/AccountDivider" />

                    <include
                        android:id="@+id/menuPayment"
                        layout="@layout/item_menu_row" />

                    <View style="@style/AccountDivider" />

                    <include
                        android:id="@+id/menuSettings"
                        layout="@layout/item_menu_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ BANTUAN & INFORMASI ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.08"
                android:text="@string/section_bantuan_info"
                android:textColor="@color/bk_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/bk_stroke_soft"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/menuCare"
                        layout="@layout/item_menu_row" />

                    <View style="@style/AccountDivider" />

                    <include
                        android:id="@+id/menuFaq"
                        layout="@layout/item_menu_row" />

                    <View style="@style/AccountDivider" />

                    <include
                        android:id="@+id/menuPolicy"
                        layout="@layout/item_menu_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ KELUAR + VERSI ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/keluar_akun"
                android:textAllCaps="false"
                android:textColor="@color/bk_danger"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/bk_danger_bg"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconTint="@color/bk_danger" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/app_version"
                android:textColor="@color/bk_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/app_copyright"
                android:textColor="@color/bk_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ============ BOTTOM NAV + FAB (sama seperti Beranda) ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:id="@+id/navContainer"
        android:clipChildren="false">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            app:elevation="4dp"
            app:itemIconTint="@color/bk_nav_item_color"
            app:itemTextColor="@color/bk_nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_bottom_nav" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabBooking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-24dp"
            android:contentDescription="@string/booking"
            android:src="@drawable/ic_calendar"
            app:backgroundTint="@color/bk_accent"
            app:elevation="24dp"
            app:tint="@android:color/white" />
    </FrameLayout>
</LinearLayout>